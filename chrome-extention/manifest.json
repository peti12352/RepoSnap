{
    "manifest_version": 3,
    "name": "RepoSnap",
    "version": "1.0",
    "permissions": [
        "activeTab",
        "storage",
        "scripting"
    ],
    "background": {
        "service_worker": "/scripts/background.js"
    },
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": ["https://github.com/*"],
            "js": ["/scripts/content.js"]
        }
    ],
    "host_permissions": [
        "https://raw.githubusercontent.com/*"
    ]
}
